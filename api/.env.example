# Supabase (Project Settings > Data API > Project URL, dan API Keys > anon public)
# Jika dikosongkan, API berjalan dengan data seed di memori (hanya untuk development lokal).
SUPABASE_URL=
SUPABASE_KEY=

# Kunci untuk endpoint tulis (POST/PUT/DELETE). Kirim lewat header: x-admin-key
# Wajib diisi di production, kalau tidak endpoint tulis ditolak (403).
ADMIN_KEY=

# Origin frontend yang diizinkan (pisahkan dengan koma). Kosong = semua origin.
CORS_ORIGIN=

PORT=3000
